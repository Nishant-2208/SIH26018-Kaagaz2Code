# Copy this file to .env and fill in real values for local development.
# NEVER commit the actual .env file.

# --- App ---
APP_NAME=Kaagaz2Code Backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+psycopg2://kaagaz2code:kaagaz2code@localhost:5432/kaagaz2code

# --- JWT / Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Object Storage (S3-compatible; MinIO locally) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=kaagaz2code-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false

# --- OCR provider ---
OCR_PROVIDER=mock

# --- AI extraction provider ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- Auto-approval thresholds ---
MIN_FIELD_CONFIDENCE=0.85
MIN_CRITICAL_FIELD_CONFIDENCE=0.90
CRITICAL_FIELDS=owner_name,survey_number,khata_number,village
MAX_ACCEPTABLE_DISCREPANCY_SEVERITY=LOW

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.tif
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg,image/tiff

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
